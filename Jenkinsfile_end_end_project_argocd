    pipeline {
        agent any
         tools { 
            maven 'maven3' 
        }
    	stages {
    	    stage('Checkout') {
    	        steps { 
                    echo 'Cloning GIT HUB Repo' 
                    // Clone the specified branch from the GitHub repository 
                    git branch: 'main', url: 'https://github.com/Navindra0710/mindcircuit16d.git'
                }   
            } 
            stage('SonarQube Scan') {
                steps {
                echo 'Scanning project'
                sh 'ls -ltr'
                sh '''
                  mvn sonar:sonar \
                    -Dsonar.host.url=http://54.234.250.214:9001 \
                    -Dsonar.login=squ_6a541ffeb396435384ec81288c2814f7af74af88
                '''
                }
            }
            
            stage('Build Artifact') { 
                steps { 
                    echo 'Build Artifact' 
                    sh 'mvn clean package' 
                } 
            }
            
            stage('Build Docker Image') { 
                steps { 
                    echo 'Build Docker Image' 
                    // Build the Docker image using the Dockerfile in the project 
                    // Tag the image with the current build number 
                    sh 'docker build -t navidocker0710/navidockercicdargocd:${BUILD_NUMBER} -f Dockerfile .' 
                    
                } 
                
            } 
            
            stage('Scan Docker Image using Trivy') { 
                steps { 
                    echo 'scanning Image' 
                    sh 'trivy image navidocker0710/navidockercicdargocd:${BUILD_NUMBER}' 
                }
                
            }
            
            stage('Push to Docker Hub') { 
                steps { 
                    script { 
                     
                      	withCredentials([string(credentialsId: 'dockerhub', variable: 'dockerhub')]) {
                             sh 'docker login -u navidocker0710 -p ${dockerhub}' 
    	
                          }
                        // Push the Docker image to Docker Hub 
                        sh 'docker push navidocker0710/navidockercicdargocd:${BUILD_NUMBER}' 
                        echo 'Pushed to Docker Hub' 
                    } 
                } 
            } 
            
            stage('Update Deployment File') { 
                environment { 
                    GIT_REPO_NAME = "mindcircuit16d" 
                    GIT_USER_NAME = "Navindra0710" 
                } 
                steps { 
                    echo 'Update Deployment File' 
    				
    				withCredentials([string(credentialsId: 'gitcicdtoken', variable: 'gitcicdtoken')]) {
        // some block
    }
                  
                    withCredentials([string(credentialsId: 'gitcicdtoken', variable: 'gitcicdtoken')]) { 
                        sh ''' 
                            # Configure git user 
                            git config user.email "navi0710@gmail.com" 
                            git config user.name "navi" 
    						
                            # Replace the tag in the deployment YAML file with the current buil  number 						
                            sed -i "s/navidockercicdargocd:.*/navidockercicdargocd:${BUILD_NUMBER}/g" deploymentfiles/deployment.yaml 
    						
    						
                            #Stage all changes 
    
                            git add . 
                            # Commit changes with a message containing the build number 
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}" 
                            #Push changes to the main branch of the GitHub repository 
                            git push https://${gitcicdtoken}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main ''' 
                    } 
                } 
            } 
             
        } 
    }
